#Область ОбработчикиHTTPСервиса

Функция CategoriesGET(Запрос) Экспорт

	Если Не АвторизацияВыполнена(Запрос) Тогда
		Возврат ОтветСОшибкой("Неверный токен доступа", 401);
	КонецЕсли;

	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
		"ВЫБРАТЬ
		| Категории.Ссылка КАК Ссылка,
		| Категории.Наименование КАК Наименование,
		| ВЫБОР
		| 	КОГДА Категории.Наименование = ""Другое""
		| 		ТОГДА 1
		| 	ИНАЧЕ 0
		| КОНЕЦ КАК ПорядокСортировки
		|ИЗ
		| Справочник.КатегорииЗаявок КАК Категории
		|ГДЕ
		| НЕ Категории.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		| ПорядокСортировки,
		| Категории.Наименование";

	Элементы = Новый Массив;
	Выборка = ЗапросДанных.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Элемент.Вставить("name", Выборка.Наименование);
		Элементы.Добавить(Элемент);
	КонецЦикла;

	Возврат ОтветJSON(Новый Структура("items", Элементы));

КонецФункции

Функция IssuesPOST(Запрос) Экспорт

	Если Не АвторизацияВыполнена(Запрос) Тогда
		Возврат ОтветСОшибкой("Неверный токен доступа", 401);
	КонецЕсли;

	Попытка
		Данные = ПрочитатьJSONЗапроса(Запрос);
	Исключение
		Возврат ОтветСОшибкой("Некорректное тело JSON", 400);
	КонецПопытки;

	ОбязательныеПоля = Новый Массив;
	ОбязательныеПоля.Добавить("telegram_user_id");
	ОбязательныеПоля.Добавить("telegram_full_name");
	ОбязательныеПоля.Добавить("category_id");
	ОбязательныеПоля.Добавить("subject");
	ОбязательныеПоля.Добавить("description");
	ОбязательныеПоля.Добавить("priority");

	Для Каждого ИмяПоля Из ОбязательныеПоля Цикл
		Если Не Данные.Свойство(ИмяПоля) Тогда
			Возврат ОтветСОшибкой("Не заполнено поле: " + ИмяПоля, 400);
		КонецЕсли;
	КонецЦикла;

	Если СтрДлина(СокрЛП(Данные.subject)) < 3 Или СтрДлина(Данные.subject) > 120 Тогда
		Возврат ОтветСОшибкой("Тема должна содержать от 3 до 120 символов", 400);
	КонецЕсли;

	Если СтрДлина(СокрЛП(Данные.description)) < 5 Или СтрДлина(Данные.description) > 2000 Тогда
		Возврат ОтветСОшибкой("Описание должно содержать от 5 до 2000 символов", 400);
	КонецЕсли;

	Попытка
		Категория = Справочники.КатегорииЗаявок.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Данные.category_id));
	Исключение
		Возврат ОтветСОшибкой("Некорректный идентификатор категории", 400);
	КонецПопытки;

	Если Не ЗначениеЗаполнено(Категория) Или Категория.ПометкаУдаления Тогда
		Возврат ОтветСОшибкой("Категория не найдена", 404);
	КонецЕсли;

	Приоритет = КодВПриоритет(Данные.priority);
	Если Приоритет = Неопределено Тогда
		Возврат ОтветСОшибкой("Неизвестный приоритет", 400);
	КонецЕсли;

	Username = "";
	Если Данные.Свойство("telegram_username") И Данные.telegram_username <> Неопределено Тогда
		Username = Данные.telegram_username;
	КонецЕсли;

	Попытка
		НачатьТранзакцию();

		Пользователь = ПолучитьИлиСоздатьПользователя(
			Данные.telegram_user_id,
			Username,
			Данные.telegram_full_name);

		ЗаявкаОбъект = Документы.Заявка.СоздатьДокумент();
		ЗаявкаОбъект.Дата = ТекущаяДатаСеанса();
		ЗаявкаОбъект.ПользовательТелеграм = Пользователь;
		ЗаявкаОбъект.Категория = Категория;
		ЗаявкаОбъект.Тема = СокрЛП(Данные.subject);
		ЗаявкаОбъект.Описание = Данные.description;
		ЗаявкаОбъект.Приоритет = Приоритет;
		ЗаявкаОбъект.Статус = Перечисления.СтатусыЗаявок.Новая;
		ЗаявкаОбъект.Записать();

		ЗафиксироватьТранзакцию();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Возврат ОтветСОшибкой("Не удалось зарегистрировать заявку: " + ТекстОшибки, 500);
	КонецПопытки;

	Возврат ОтветJSON(КраткоеПредставлениеЗаявки(ЗаявкаОбъект.Ссылка), 201);

КонецФункции

Функция IssuesGET(Запрос) Экспорт

	Если Не АвторизацияВыполнена(Запрос) Тогда
		Возврат ОтветСОшибкой("Неверный токен доступа", 401);
	КонецЕсли;

	TelegramID = ПараметрЗапроса(Запрос, "telegram_user_id");
	Если ПустаяСтрока(TelegramID) Тогда
		Возврат ОтветСОшибкой("Не указан telegram_user_id", 400);
	КонецЕсли;

	Лимит = 10;
	СтрокаЛимита = ПараметрЗапроса(Запрос, "limit");
	Если Не ПустаяСтрока(СтрокаЛимита) Тогда
		Попытка
			Лимит = Число(СтрокаЛимита);
		Исключение
			Возврат ОтветСОшибкой("Некорректный limit", 400);
		КонецПопытки;
	КонецЕсли;
	Лимит = Макс(1, Мин(Лимит, 50));

	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
		| Заявка.Ссылка КАК Ссылка
		|ИЗ
		| Документ.Заявка КАК Заявка
		|ГДЕ
		| Заявка.ПользовательТелеграм.TelegramID = &TelegramID
		|УПОРЯДОЧИТЬ ПО
		| Заявка.Дата УБЫВ";
	ЗапросДанных.УстановитьПараметр("TelegramID", Число(TelegramID));

	Элементы = Новый Массив;
	Выборка = ЗапросДанных.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элементы.Добавить(ПолноеПредставлениеЗаявки(Выборка.Ссылка));
	КонецЦикла;

	Возврат ОтветJSON(Новый Структура("items", Элементы));

КонецФункции

Функция IssueGET(Запрос) Экспорт

	Если Не АвторизацияВыполнена(Запрос) Тогда
		Возврат ОтветСОшибкой("Неверный токен доступа", 401);
	КонецЕсли;

	РезультатПроверки = ПроверитьДоступКЗаявке(Запрос);
	Если ТипЗнч(РезультатПроверки) = Тип("HTTPСервисОтвет") Тогда
		Возврат РезультатПроверки;
	КонецЕсли;

	Возврат ОтветJSON(ПолноеПредставлениеЗаявки(РезультатПроверки));

КонецФункции

Функция IssueCancelPOST(Запрос) Экспорт

	Если Не АвторизацияВыполнена(Запрос) Тогда
		Возврат ОтветСОшибкой("Неверный токен доступа", 401);
	КонецЕсли;

	Попытка
		Данные = ПрочитатьJSONЗапроса(Запрос);
	Исключение
		Возврат ОтветСОшибкой("Некорректное тело JSON", 400);
	КонецПопытки;

	Если Не Данные.Свойство("telegram_user_id") Тогда
		Возврат ОтветСОшибкой("Не указан telegram_user_id", 400);
	КонецЕсли;

	РезультатПроверки = ПроверитьДоступКЗаявке(Запрос, Данные.telegram_user_id);
	Если ТипЗнч(РезультатПроверки) = Тип("HTTPСервисОтвет") Тогда
		Возврат РезультатПроверки;
	КонецЕсли;

	ЗаявкаОбъект = РезультатПроверки.ПолучитьОбъект();
	Если ЗаявкаОбъект.Статус <> Перечисления.СтатусыЗаявок.Новая Тогда
		Возврат ОтветСОшибкой("Можно отменить только новую заявку", 409);
	КонецЕсли;

	ЗаявкаОбъект.Статус = Перечисления.СтатусыЗаявок.Отменена;
	ЗаявкаОбъект.Записать();

	Возврат ОтветJSON(ПолноеПредставлениеЗаявки(ЗаявкаОбъект.Ссылка));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АвторизацияВыполнена(Запрос)

	Заголовок = ЗначениеЗаголовка(Запрос, "X-API-Key");
	ОжидаемоеЗначение = СокрЛП(Константы.ТокенHTTPСервиса.Получить());
	Возврат Не ПустаяСтрока(Заголовок)
		И СокрЛП(Заголовок) = ОжидаемоеЗначение
		И Не ПустаяСтрока(ОжидаемоеЗначение);

КонецФункции

Функция ЗначениеЗаголовка(Запрос, ИмяЗаголовка)

	Для Каждого ПараЗаголовка Из Запрос.Заголовки Цикл
		Если ВРег(ПараЗаголовка.Ключ) = ВРег(ИмяЗаголовка) Тогда
			Возврат Строка(ПараЗаголовка.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ПрочитатьJSONЗапроса(Запрос)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
	ПрочитанныеДанные = ПрочитатьJSON(Чтение, Истина);

	Результат = Новый Структура;
	Для Каждого ПараДанных Из ПрочитанныеДанные Цикл
		Результат.Вставить(ПараДанных.Ключ, ПараДанных.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОтветJSON(Данные, КодСостояния = 200)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Тело = Запись.Закрыть();

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	Возврат Ответ;

КонецФункции

Функция ОтветСОшибкой(ТекстОшибки, КодСостояния)
	Возврат ОтветJSON(Новый Структура("error", ТекстОшибки), КодСостояния);
КонецФункции

Функция ПараметрЗапроса(Запрос, Имя)
	Значение = Запрос.ПараметрыЗапроса.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции

Функция ПолучитьИлиСоздатьПользователя(TelegramID, Username, ПолноеИмя)

	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Пользователи.Ссылка КАК Ссылка
		|ИЗ
		| Справочник.ПользователиТелеграм КАК Пользователи
		|ГДЕ
		| Пользователи.TelegramID = &TelegramID";
	ЗапросДанных.УстановитьПараметр("TelegramID", TelegramID);

	Выборка = ЗапросДанных.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект = Выборка.Ссылка.ПолучитьОбъект();
	Иначе
		Объект = Справочники.ПользователиТелеграм.СоздатьЭлемент();
		Объект.TelegramID = TelegramID;
	КонецЕсли;

	Объект.Username = Лев(Username, 100);
	Объект.ПолноеИмя = Лев(ПолноеИмя, 200);
	Объект.Наименование = Лев(ПолноеИмя, 200);
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция ПроверитьДоступКЗаявке(Запрос, TelegramIDИзТела = Неопределено)

	Идентификатор = Запрос.ПараметрыURL.Получить("id");
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат ОтветСОшибкой("Не указан идентификатор заявки", 400);
	КонецЕсли;

	Попытка
		Ссылка = Документы.Заявка.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
	Исключение
		Возврат ОтветСОшибкой("Некорректный идентификатор заявки", 400);
	КонецПопытки;

	Если TelegramIDИзТела = Неопределено Тогда
		TelegramID = ПараметрЗапроса(Запрос, "telegram_user_id");
	Иначе
		TelegramID = TelegramIDИзТела;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(TelegramID) Тогда
		Возврат ОтветСОшибкой("Не указан telegram_user_id", 400);
	КонецЕсли;

	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Заявка.Ссылка КАК Ссылка
		|ИЗ
		| Документ.Заявка КАК Заявка
		|ГДЕ
		| Заявка.Ссылка = &Ссылка
		| И Заявка.ПользовательТелеграм.TelegramID = &TelegramID";
	ЗапросДанных.УстановитьПараметр("Ссылка", Ссылка);
	ЗапросДанных.УстановитьПараметр("TelegramID", Число(TelegramID));

	Выборка = ЗапросДанных.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат ОтветСОшибкой("Заявка не найдена", 404);
	КонецЕсли;

	Возврат Выборка.Ссылка;

КонецФункции

Функция КраткоеПредставлениеЗаявки(Ссылка)

	Результат = Новый Структура;
	Результат.Вставить("id", Строка(Ссылка.УникальныйИдентификатор()));
	Результат.Вставить("number", СокрЛП(Строка(Ссылка.Номер)));
	Результат.Вставить("status", СтатусВКод(Ссылка.Статус));
	Результат.Вставить("status_name", Строка(Ссылка.Статус));
	Результат.Вставить("created_at", XMLСтрока(Ссылка.Дата));
	Возврат Результат;

КонецФункции

Функция ПолноеПредставлениеЗаявки(Ссылка)

	Результат = КраткоеПредставлениеЗаявки(Ссылка);
	Результат.Вставить("category_name", Строка(Ссылка.Категория));
	Результат.Вставить("subject", Ссылка.Тема);
	Результат.Вставить("description", Ссылка.Описание);
	Результат.Вставить("priority", ПриоритетВКод(Ссылка.Приоритет));
	Результат.Вставить("priority_name", Строка(Ссылка.Приоритет));
	Возврат Результат;

КонецФункции

Функция КодВПриоритет(Код)
	Если Код = "low" Тогда
		Возврат Перечисления.ПриоритетыЗаявок.Низкий;
	ИначеЕсли Код = "normal" Тогда
		Возврат Перечисления.ПриоритетыЗаявок.Обычный;
	ИначеЕсли Код = "high" Тогда
		Возврат Перечисления.ПриоритетыЗаявок.Высокий;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПриоритетВКод(Приоритет)
	Если Приоритет = Перечисления.ПриоритетыЗаявок.Низкий Тогда
		Возврат "low";
	ИначеЕсли Приоритет = Перечисления.ПриоритетыЗаявок.Высокий Тогда
		Возврат "high";
	КонецЕсли;
	Возврат "normal";
КонецФункции

Функция СтатусВКод(Статус)
	Если Статус = Перечисления.СтатусыЗаявок.ВРаботе Тогда
		Возврат "in_progress";
	ИначеЕсли Статус = Перечисления.СтатусыЗаявок.Выполнена Тогда
		Возврат "completed";
	ИначеЕсли Статус = Перечисления.СтатусыЗаявок.Отклонена Тогда
		Возврат "rejected";
	ИначеЕсли Статус = Перечисления.СтатусыЗаявок.Отменена Тогда
		Возврат "cancelled";
	КонецЕсли;
	Возврат "new";
КонецФункции

#КонецОбласти

